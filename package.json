{
  "name": "joshua-exe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && node scripts/gzip-cast.mjs && vite build && node scripts/prerender.mjs && node scripts/flatten-dist.mjs",
    "prepreview": "wrangler d1 migrations apply joshua-booth-local --local",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:staging": "node scripts/free-gate.mjs && CLOUDFLARE_ENV=staging npm run build && node scripts/check-staging.mjs && wrangler deploy --config dist/joshua_exe_local/wrangler.json",
    "audit:assets": "node scripts/asset-audit.mjs",
    "verify:theater": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/verify-theater.mjs",
    "harvest:theater": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/harvest-theater.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.47.0"
  }
}
