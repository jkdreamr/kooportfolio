{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshua-exe-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Local preview only: one emulated D1 (under .wrangler) holds the wall,
  // the shelf and reports, as in production. `npm run prepreview` applies
  // every migration in migrations/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "joshua-booth-local",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "env": { "staging": { "name": "joshua-exe-staging", "workers_dev": true } },
}
